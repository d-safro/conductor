# The migrations are fingerprinted into every database: the same bytes on every system (a Windows checkout would
# otherwise turn them into CRLF and give them other fingerprints). See db::open.
migrations/*.sql text eol=lf
# The web pages' scripts are allowed by their hash (src/page.rs), which is taken with LF line ends, as browsers
# read them: the same bytes on every system.
web/** text eol=lf
